{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://faithflow-backend-new.onrender.com/:path*" },
    { "source": "/admin-api/:path*", "destination": "https://faithflow-backend-new.onrender.com/admin-api/:path*" },
    { "source": "/((?!api/|admin-api/).*)", "destination": "/index.html" }
  ]
}
