# Priest credential email delivery (Gmail SMTP fallback)
# The parish Email on Profile is the live sender. These values are used only
# until a Gmail + App Password is saved on the Profile page.
PRIEST_SMTP_HOST=smtp.gmail.com
PRIEST_SMTP_PORT=465
PRIEST_SMTP_SECURE=true
PRIEST_SMTP_USER=
PRIEST_SMTP_PASS=
PRIEST_SMTP_FROM=

# Alternative: Gmail OAuth2 (no App Password)
# If all fields below are set, backend will prefer OAuth2 over PRIEST_SMTP_PASS.
PRIEST_GMAIL_OAUTH_USER=
PRIEST_GMAIL_OAUTH_CLIENT_ID=
PRIEST_GMAIL_OAUTH_CLIENT_SECRET=
PRIEST_GMAIL_OAUTH_REFRESH_TOKEN=
PRIEST_GMAIL_OAUTH_REDIRECT_URI=
